import numpy as np
import tensorflow as tf
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

# Generate 2-class spiral dataset
def generate_spiral(n_points, noise=0.2):
    n = np.sqrt(np.random.rand(n_points)) * 780 * (2*np.pi)/360
    d1 = np.vstack([np.cos(n)*n + np.random.rand(n_points)*noise,
                    np.sin(n)*n + np.random.rand(n_points)*noise]).T
    d2 = np.vstack([np.cos(n+np.pi)*n + np.random.rand(n_points)*noise,
                    np.sin(n+np.pi)*n + np.random.rand(n_points)*noise]).T
    X = np.vstack([d1, d2])
    y = np.hstack([np.zeros(n_points), np.ones(n_points)])
    return X, y

X, y = generate_spiral(1000)
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)

# Neural Network
model = tf.keras.Sequential([
    tf.keras.layers.Dense(64, activation='tanh', input_shape=(2,)),
    tf.keras.layers.Dense(64, activation='tanh'),
    tf.keras.layers.Dense(1, activation='sigmoid')
])

model.compile(optimizer="adam", loss="binary_crossentropy", metrics=["accuracy"])
model.fit(X_train, y_train, epochs=30, batch_size=32, verbose=0)

# Evaluate
pred = (model.predict(X_test) > 0.5).astype("int32")
acc = accuracy_score(y_test, pred)

print("Spiral Data Accuracy:", acc)
