from sklearn.datasets import make_classification
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import accuracy_score
import tensorflow as tf

# Generate multi-class dataset
X, y = make_classification(n_samples=3000, n_features=12, n_classes=4, n_informative=6, random_state=42)

sc = StandardScaler()
X = sc.fit_transform(X)

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)

# Convert to categorical
y_train_c = tf.keras.utils.to_categorical(y_train, 4)
y_test_c  = tf.keras.utils.to_categorical(y_test, 4)

# NN Model
model = tf.keras.Sequential([
    tf.keras.layers.Dense(64, activation="relu", input_shape=(12,)),
    tf.keras.layers.Dense(32, activation="relu"),
    tf.keras.layers.Dense(4, activation="softmax")   # 4-class output
])

model.compile(optimizer="adam", loss="categorical_crossentropy", metrics=["accuracy"])
model.fit(X_train, y_train_c, epochs=10, batch_size=32, verbose=0)

# Evaluate
loss, acc = model.evaluate(X_test, y_test_c, verbose=0)
print("Multi-Class Classification Accuracy:", acc)
