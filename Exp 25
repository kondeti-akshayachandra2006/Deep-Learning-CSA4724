import tensorflow as tf
from tensorflow.keras.layers import Dense, Flatten, LeakyReLU
from tensorflow.keras.datasets import mnist
from sklearn.metrics import accuracy_score

# Load MNIST
(X_train, y_train), (X_test, y_test) = mnist.load_data()
X_train = X_train.reshape(-1, 784)/255.0
X_test = X_test.reshape(-1, 784)/255.0

activations = ["relu", "sigmoid", "tanh"]
structures = [
    [128, 64],
    [256, 128, 64],
    [64, 64, 64]
]

for act in activations:
    for layer_structure in structures:

        print(f"\nActivation = {act}, Structure = {layer_structure}")

        model = tf.keras.Sequential()
        model.add(Dense(layer_structure[0], activation=act, input_shape=(784,)))

        for units in layer_structure[1:]:
            model.add(Dense(units, activation=act))

        model.add(Dense(10, activation="softmax"))

        model.compile(optimizer="adam", loss="sparse_categorical_crossentropy", metrics=["accuracy"])
        model.fit(X_train, y_train, epochs=2, batch_size=64, verbose=0)

        loss, acc = model.evaluate(X_test, y_test, verbose=0)
        print("Accuracy:", acc)

# Example using LeakyReLU
print("\nTesting LeakyReLU...")
model = tf.keras.Sequential([
    Dense(128),
    LeakyReLU(alpha=0.1),
    Dense(64),
    LeakyReLU(alpha=0.1),
    Dense(10, activation="softmax")
])
model.compile(optimizer="adam", loss="sparse_categorical_crossentropy", metrics=["accuracy"])
model.fit(X_train, y_train, epochs=2, batch_size=64, verbose=0)
loss, acc = model.evaluate(X_test, y_test, verbose=0)
print("LeakyReLU Accuracy:", acc)
